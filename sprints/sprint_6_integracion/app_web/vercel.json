{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo Sin dependencias que instalar",
  "buildCommand": "node construir.mjs",
  "outputDirectory": "publico",
  "crons": [
    {
      "path": "/api/mantener-activo",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/encuesta/:token([0-9a-f]{32})",
      "destination": "/encuesta.html"
    },
    {
      "source": "/entrevista/:token([0-9a-f]{32})",
      "destination": "/entrevista.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/((?!ruta-google).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://*.supabase.co https://tile.openstreetmap.org; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://serviciosgis.catastrobogota.gov.co https://router.project-osrm.org; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/ruta-google(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(index.html|404.html|encuesta.html|ruta-google.html|ruta-google.js|modelo.json|config.js|app.js|ui.js|datos.js|formulario.js|analitica.js|equipo.js|perfil.js|mapa.js|encuestas.js|qr.js|encuesta.js|modelo.js|estilos.css|encuesta.css|psicologia.js|psicologia.css|vocacional.js|entrevista.html|entrevista.js|entrevista.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/encuesta/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/entrevista/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
