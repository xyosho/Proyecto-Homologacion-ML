# Plantilla de credenciales. Copie este archivo como .env (excluido por .gitignore) y complete los valores.
# NUNCA escriba estos valores en el código, en los cuadernos ni en los documentos.

# Supabase -> Project Settings -> API Keys
SUPABASE_URL=
# Clave PUBLICABLE: por las políticas RLS solo puede leer las tablas planas (dataset_matricula y
# dataset_permanencia). Nunca la clave secreta.
SUPABASE_KEY=
