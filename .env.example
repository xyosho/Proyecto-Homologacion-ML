# Plantilla de credenciales. Copie este archivo como .env (excluido por .gitignore) y complete los valores.
# NUNCA escriba estos valores en el código, en los cuadernos ni en los documentos.
# También puede crear el .env con:  python src/s00_configurar_credenciales.py

# Supabase -> Project Settings -> API Keys
SUPABASE_URL=
# Clave PUBLICABLE (solo puede leer la tabla dataset_matricula por la política RLS)
SUPABASE_KEY=

# Opcional, solo para recargar los datos con src/s05_cargar_supabase.py (Supabase -> Connect -> Session pooler).
# Contiene la contraseña de la base: no la comparta.
SUPABASE_DB_URL=
